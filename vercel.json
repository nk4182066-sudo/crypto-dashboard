{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    { "path": "/api/signals/live", "schedule": "0 3 * * *" },
    { "path": "/api/track-signals", "schedule": "30 15 * * *" }
  ],
  "functions": {
    "app/api/signals/live/route.ts": {
      "maxDuration": 10
    },
    "app/api/market/history/route.ts": {
      "maxDuration": 10
    },
    "app/api/market-signals/route.ts": {
      "maxDuration": 10
    },
    "app/api/market/scan/route.ts": {
      "maxDuration": 10
    }
  }
}

